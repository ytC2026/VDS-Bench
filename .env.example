# Change only this line to switch the active endpoint profile.
# Choices: qwen | kimi | mimo | minimax | generic
VDS_PROVIDER=qwen

# Qwen / Alibaba Cloud Model Studio
VDS_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VDS_QWEN_API_KEY=replace_with_your_qwen_api_key
VDS_QWEN_MODEL=qwen3.7-plus
VDS_QWEN_TEMPERATURE=0

# Kimi / Moonshot. Kimi-K3 temperature is provider-fixed and omitted on wire.
VDS_KIMI_BASE_URL=https://api.moonshot.cn/v1
VDS_KIMI_API_KEY=replace_with_your_kimi_api_key
VDS_KIMI_MODEL=kimi-k3
VDS_KIMI_REASONING_EFFORT=low

# Xiaomi MiMo
VDS_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
VDS_MIMO_API_KEY=replace_with_your_mimo_api_key
VDS_MIMO_MODEL=mimo-v2.5
VDS_MIMO_TEMPERATURE=0

# MiniMax (global endpoint; China endpoint: https://api.minimaxi.com/v1)
VDS_MINIMAX_BASE_URL=https://api.minimax.io/v1
VDS_MINIMAX_API_KEY=replace_with_your_minimax_api_key
VDS_MINIMAX_MODEL=MiniMax-M3
VDS_MINIMAX_TEMPERATURE=1

# Any other OpenAI-compatible multimodal chat-completions endpoint.
VDS_GENERIC_BASE_URL=https://api.example.com/v1
VDS_GENERIC_API_KEY=replace_with_your_api_key
VDS_GENERIC_MODEL=replace-with-multimodal-model-id
VDS_GENERIC_TEMPERATURE=0
VDS_GENERIC_RESPONSE_FORMAT_JSON=true

